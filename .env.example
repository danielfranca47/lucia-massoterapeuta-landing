# Credenciais da Service Account do Google Calendar, usadas pela rota
# src/app/api/availability/route.ts para ler a disponibilidade real da
# agenda da Lúcia (só livre/ocupado, nunca escreve na agenda).
#
# Passo a passo para gerar essas credenciais:
# docs/implementations/sincronizacao-google-agenda.md, seção "Fase 1".
#
# Copie este arquivo para .env.local (não comitado) e preencha com os
# valores reais para rodar localmente. Em produção, configure as mesmas
# variáveis em Vercel → Project Settings → Environment Variables.

# IDs das agendas a consultar, separados por vírgula (a Lúcia mantém 3
# agendas separadas — Air BnB, Terraço, Gabinete Faro — e qualquer
# compromisso em qualquer uma delas conta como indisponibilidade, já que ela
# é uma pessoa só). Cada ID fica em Configurações da agenda → "Integrar
# agenda", dentro do Google Calendar de cada uma das 3.
GOOGLE_CALENDAR_IDS=agenda-airbnb@group.calendar.google.com,agenda-terraco@group.calendar.google.com,agenda-gabinete-faro@group.calendar.google.com

# E-mail da Service Account criada no Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=exemplo@nome-do-projeto.iam.gserviceaccount.com

# Chave privada da Service Account (campo "private_key" do JSON gerado).
# Cole com as quebras de linha como "\n" literais, numa única linha.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExemplo...\n-----END PRIVATE KEY-----\n"
